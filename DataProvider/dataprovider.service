[Unit]
Description=Finam DataProvider
After=network.target
Before=hedgefund-server.service

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/HedgeFund/DataProvider
EnvironmentFile=/root/.openclaw/workspace/HedgeFund/.env
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/HedgeFund/DataProvider/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
