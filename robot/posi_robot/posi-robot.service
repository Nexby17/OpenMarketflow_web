[Unit]
Description=POSI Robot (Donchian N240 k2.5 strict, spot POSI@MISX) - REAL
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/HedgeFund/robot/posi_robot
EnvironmentFile=/root/.openclaw/workspace/HedgeFund/.env
Environment=PYTHONPATH=/root/.openclaw/workspace/HedgeFund/robot:/root/.openclaw/workspace/HedgeFund/DataProvider
Environment=FINAM_ACCOUNT=2049688
Environment=DP_URL=http://localhost:5060
ExecStartPre=/bin/rm -rf /root/.openclaw/workspace/HedgeFund/robot/posi_robot/__pycache__
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/HedgeFund/robot/posi_robot/main_posi.py --port 5098
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
