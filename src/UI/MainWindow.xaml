<Window x:Class="HedgeFund.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HedgeFund.UI.ViewModels"
        xmlns:conv="clr-namespace:HedgeFund.UI.Converters"
        Title="OpenMarketflow" 
        Width="1050" Height="780" 
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:PnLColorConverter x:Key="PnLColor"/>
        <conv:BoolToOnOffConverter x:Key="BoolOnOff"/>
        <conv:StringToBrushConverter x:Key="StringBrush"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NonZeroToVisibilityConverter x:Key="NonZeroVis"/>
    </Window.Resources>

    <Grid>
        <!-- Заголовок -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: логотип + сервер + СТОП -->
        <Grid Grid.Row="0" Margin="16,10,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: логотип + статус -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="⚡ OpenMarketflow" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="{Binding StatusColor, Converter={StaticResource StringBrush}}"/>
            </StackPanel>

            <!-- Центр: подключение к серверу -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                         Fill="{Binding ServerConnectionColor, Converter={StaticResource StringBrush}}"/>
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="{Binding ConnectServerButtonText}" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding ConnectServerCommand}" Margin="6,0,0,0" Padding="10,4" FontSize="11"/>
            </StackPanel>

            <!-- Правая часть: ЭКСТРЕННАЯ ОСТАНОВКА + Пауза -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="⏸" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding PauseTradingCommand}" 
                        ToolTip="Пауза торговли" Padding="8,4" FontSize="14" Margin="0,0,6,0"/>
                <Button Content="🔴 СТОП" Style="{StaticResource DangerButton}" 
                        Command="{Binding EmergencyStopCommand}" 
                        ToolTip="Экстренная остановка — закрыть все позиции" 
                        Padding="14,6" FontSize="13" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Margin="12,4,12,12">

            <!-- ==================== ВКЛАДКА: ТОРГОВЛЯ ==================== -->
            <TabItem Header="📊 Торговля">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Токен -->
                        <RowDefinition Height="Auto"/>   <!-- Выбор брокера/инструмента -->
                        <RowDefinition Height="Auto"/>   <!-- Кнопки старт/стоп -->
                        <RowDefinition Height="Auto"/>   <!-- Усреднение -->
                        <RowDefinition Height="*"/>      <!-- Позиции -->
                        <RowDefinition Height="*"/>      <!-- Лог -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: Статус токена -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Токен Финам: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SettingsVM.FinamTokenMasked}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding SettingsVM.HasFinamToken, Converter={StaticResource BoolOnOff}}"/>
                            <TextBlock Text="  │  Токен Альфа: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding SettingsVM.AlfaTokenMasked}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="  ← укажите во вкладке Настройки" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1: Выбор брокера / инструмента / стратегии -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Label Content="Брокер"/>
                            <ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <Label Content="Инструмент"/>
                            <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <Label Content="Стратегия"/>
                            <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: Кнопки управления -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🔌 Подключиться" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding ConnectBrokerCommand}" Width="150" Padding="8,6"/>
                        <TextBlock Text="{Binding BrokerStatusText}" VerticalAlignment="Center" 
                                   Margin="10,0,0,0" FontSize="12"/>
                        <Button Content="🤖 Запустить бота" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding StartBotCommand}" Width="150" Margin="16,0,0,0" Padding="8,6"/>
                        <Button Content="⏹ Стоп" Style="{StaticResource DangerButton}" 
                                Command="{Binding StopCommand}" Width="80" Margin="8,0,0,0" Padding="8,6"/>
                        <TextBlock VerticalAlignment="Center" Margin="24,0,0,0" FontSize="16">
                            <Run Text="Баланс: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding Balance, StringFormat=N0}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="18"/>
                            <Run Text=" ₽" Foreground="{StaticResource PrimaryBrush}" FontSize="16"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ROW 3: Управление усреднением -->
                    <GroupBox Grid.Row="3" Header="Управление усреднением">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <Label Content="Режим"/>
                                <ToggleButton Style="{StaticResource ToggleBtn}" 
                                              IsChecked="{Binding IsMartingale}"
                                              Content="{Binding AveragingModeText}" 
                                              Width="130"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <Label Content="Базовый лот"/>
                                <TextBox Text="{Binding BaseLotSize, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="60" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,20,0">
                                <Label Content="Макс. усреднений (0=∞)"/>
                                <TextBox Text="{Binding MaxAveraging, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="60" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ToggleButton Style="{StaticResource ToggleBtn}" 
                                              IsChecked="{Binding StopLossEnabled}" 
                                              Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Стоп-лосс: "/>
                                        <TextBlock Text="{Binding StopLossEnabled, Converter={StaticResource BoolOnOff}}"/>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBox Text="{Binding StopLossValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="70" TextAlignment="Center" Margin="0,0,4,0"
                                         IsEnabled="{Binding StopLossEnabled}"/>
                                <ComboBox ItemsSource="{Binding StopLossModes}" 
                                          SelectedItem="{Binding SelectedStopLossMode}" 
                                          Width="80"
                                          IsEnabled="{Binding StopLossEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- ROW 4: Таблица позиций -->
                    <GroupBox Grid.Row="4" Header="Открытые позиции" Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding Positions}" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тикер" Binding="{Binding Ticker}" Width="80"/>
                                <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="90"/>
                                <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePrice, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="Объём" Binding="{Binding TotalVolume}" Width="65"/>
                                <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat=F2}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding PnLColor, Converter={StaticResource StringBrush}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Усреднений" Binding="{Binding AveragingCount}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- ROW 5: Лог событий -->
                    <GroupBox Grid.Row="5" Header="Лог событий" Margin="0,8,0,0">
                        <ListBox Style="{StaticResource LogList}" 
                                 ItemsSource="{Binding LogEntries}"
                                 x:Name="LogListBox"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ==================== ВКЛАДКА: МОНИТОРИНГ (с вложенными табами) ==================== -->
            <TabItem Header="📈 Мониторинг">
                <TabControl Margin="4">

                    <!-- ===== Подвкладка: Обзор ===== -->
                    <TabItem Header="📊 Обзор" DataContext="{Binding MonitoringVM}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Карточки метрик -->
                        <RowDefinition Height="Auto"/>   <!-- Equity curve -->
                        <RowDefinition Height="*"/>      <!-- Позиции -->
                    </Grid.RowDefinitions>

                    <!-- Блок статистики: карточки -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ряд 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Баланс" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Balance, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Equity" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Equity, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="PnL сегодня" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PnLToday, StringFormat={}{0:+#,0;-#,0;0}}" FontSize="20" FontWeight="Bold" 
                                           Foreground="{Binding PnLTodayColor, Converter={StaticResource StringBrush}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="PnL всего" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PnLTotal, StringFormat={}{0:+#,0;-#,0;0}}" FontSize="20" FontWeight="Bold" 
                                           Foreground="{Binding PnLTotalColor, Converter={StaticResource StringBrush}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Win Rate" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding WinRate, StringFormat=F1}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Ряд 2 -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Profit Factor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ProfitFactor, StringFormat=F2}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Sharpe Ratio" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SharpeRatio, StringFormat=F2}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Открыто позиций" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OpenPositionsCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YellowBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Сделок сегодня" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TradesToday}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Equity Curve -->
                    <GroupBox Grid.Row="1" Header="Кривая доходности (Equity)" Margin="0,0,0,8">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                            <Canvas Height="220" ClipToBounds="True">
                                <!-- Пунктирная линия начального баланса -->
                                <Line X1="0" X2="780" 
                                      Y1="{Binding InitialBalanceY}" Y2="{Binding InitialBalanceY}"
                                      Stroke="{StaticResource TextSecondaryBrush}" 
                                      StrokeDashArray="4 2" StrokeThickness="1" Opacity="0.5"/>
                                <!-- Equity polyline -->
                                <Polyline Points="{Binding EquityPointsGeometry}" 
                                          Stroke="{StaticResource GreenBrush}" 
                                          StrokeThickness="2" 
                                          Fill="Transparent"/>
                            </Canvas>
                        </Border>
                    </GroupBox>

                    <!-- Текущие позиции -->
                    <GroupBox Grid.Row="2" Header="Открытые позиции (реалтайм)">
                        <DataGrid ItemsSource="{Binding OpenPositions}" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тикер" Binding="{Binding Ticker}" Width="90"/>
                                <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="100"/>
                                <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePrice, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Объём" Binding="{Binding TotalVolume}" Width="70"/>
                                <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat=F2}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding PnLColor, Converter={StaticResource StringBrush}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Усреднений" Binding="{Binding AveragingCount}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
                    </TabItem>

                    <!-- ===== Подвкладка: Сделки ===== -->
                    <TabItem Header="📋 Сделки" DataContext="{Binding TradesVM}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Фильтры -->
                        <RowDefinition Height="*"/>      <!-- Таблица сделок -->
                        <RowDefinition Height="Auto"/>   <!-- Суммарная статистика -->
                    </Grid.RowDefinitions>

                    <!-- Фильтры -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="С:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker SelectedDate="{Binding FilterFrom}" Width="130" VerticalAlignment="Center"/>

                            <Label Content="По:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <DatePicker SelectedDate="{Binding FilterTo}" Width="130" VerticalAlignment="Center"/>

                            <Label Content="Тикер:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBox Text="{Binding FilterTicker, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="100" VerticalAlignment="Center"/>

                            <Button Content="🔄 Сброс" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ResetFilterCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Таблица сделок -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredTrades}" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вход" Binding="{Binding EntryTime, StringFormat=dd.MM.yy HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="Выход" Binding="{Binding ExitTime, StringFormat=dd.MM.yy HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="Тикер" Binding="{Binding Ticker}" Width="75"/>
                            <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="95"/>
                            <DataGridTextColumn Header="Вход" Binding="{Binding EntryPrice, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="Выход" Binding="{Binding ExitPrice, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="Объём" Binding="{Binding Volume}" Width="60"/>
                            <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat=F2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding PnLColor, Converter={StaticResource StringBrush}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Стратегия" Binding="{Binding Strategy}" Width="120"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Суммарная статистика -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,10" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13">
                                <Run Text="Всего сделок: "/>
                            </TextBlock>
                            <TextBlock Text="{Binding TotalTradesCount}" FontWeight="Bold" FontSize="14" 
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,24,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Total PnL: " Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="{Binding TotalPnL, StringFormat=F2}" FontWeight="Bold" FontSize="14" 
                                       Foreground="{Binding TotalPnLColor, Converter={StaticResource StringBrush}}" 
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text=" ₽" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,24,0"/>

                            <TextBlock Text="Win Rate: " Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="{Binding WinRate, StringFormat=F1}" FontWeight="Bold" FontSize="14" 
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="%" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                    </TabItem>

                    <!-- ===== Подвкладка: Заявки ===== -->
                    <TabItem Header="📋 Заявки" DataContext="{Binding OrdersVM}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔄 Обновить" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                            <Button Content="❌ Отменить все" Style="{StaticResource DangerButton}" 
                                    Command="{Binding CancelAllCommand}" Margin="0,0,24,0"/>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Активных: "/>
                                <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveOrders}" VerticalScrollBarVisibility="Auto" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Тикер" Binding="{Binding Ticker}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Напр." Binding="{Binding Direction}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="Объём" Binding="{Binding Volume}" Width="65"/>
                            <DataGridTextColumn Header="Исп." Binding="{Binding FilledVolume}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StatusColor, Converter={StaticResource StringBrush}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✔ Прим." Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ModifyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="✖" Style="{StaticResource DangerButton}" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,10" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="Двойной клик по ячейке Цена/Объём → редактирование → кнопка Прим. для отправки"/>
                        </TextBlock>
                    </Border>
                </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- ==================== ВКЛАДКА: ТЕСТИРОВАНИЕ ==================== -->
            <TabItem Header="🧪 Тестирование" DataContext="{Binding BacktestVM}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ ПАНЕЛЬ: Настройки -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                        <StackPanel>
                            <GroupBox Header="Параметры теста">
                                <StackPanel>
                                    <Label Content="Стратегия"/>
                                    <ComboBox ItemsSource="{Binding StrategyNames}" 
                                              SelectedItem="{Binding SelectedStrategyName}" Margin="0,0,0,6"/>

                                    <Label Content="Инструмент"/>
                                    <ComboBox ItemsSource="{Binding Tickers}" 
                                              SelectedItem="{Binding SelectedTicker}" 
                                              Margin="0,0,0,6"/>

                                    <Label Content="Таймфрейм"/>
                                    <ComboBox ItemsSource="{Binding Timeframes}" 
                                              SelectedItem="{Binding SelectedTimeframe}" Margin="0,0,0,6"/>

                                    <Label Content="Дата от"/>
                                    <DatePicker SelectedDate="{Binding DateFrom}" Margin="0,0,0,6"/>

                                    <Label Content="Дата до"/>
                                    <DatePicker SelectedDate="{Binding DateTo}" Margin="0,0,0,6"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Параметры стратегии">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Channel"/>
                                            <TextBox Text="{Binding ChannelPeriod, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="VolMult"/>
                                            <TextBox Text="{Binding VolumeMult, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="ExitSMA"/>
                                            <TextBox Text="{Binding ExitSMA, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Лоты"/>
                                            <TextBox Text="{Binding Lots, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="StopLoss"/>
                                            <TextBox Text="{Binding StopLoss, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="TakeProfit"/>
                                            <TextBox Text="{Binding TakeProfit, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Label Content="Комиссия (₽ за сделку)"/>
                                    <TextBox Text="{Binding Commission, UpdateSourceTrigger=PropertyChanged}" 
                                             TextAlignment="Center" Margin="0,0,0,4"/>

                                    <CheckBox Content="Закрывать в конце дня" 
                                              IsChecked="{Binding CloseEndOfDay}" 
                                              Foreground="{StaticResource TextBrush}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Кнопки управления -->
                            <Button Content="▶  Запустить тест" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding RunTestCommand}" Margin="0,8,0,4"/>
                            <Button Content="⏹  Отменить" Style="{StaticResource DangerButton}" 
                                    Command="{Binding CancelTestCommand}" Margin="0,0,0,8"/>

                            <!-- Прогресс -->
                            <ProgressBar Height="6" Margin="0,0,0,4"
                                         Value="{Binding Progress}" Maximum="100"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ПРАВАЯ ПАНЕЛЬ: Результаты -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Карточки метрик -->
                            <RowDefinition Height="Auto"/>   <!-- Equity curve -->
                            <RowDefinition Height="*"/>      <!-- Таблица сделок -->
                            <RowDefinition Height="Auto"/>   <!-- Кнопка применить -->
                        </Grid.RowDefinitions>

                        <!-- Карточки метрик -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="PnL" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ResultPnL, StringFormat={}{0:+#,0.00;-#,0.00;0}}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="{Binding ResultPnLColor, Converter={StaticResource StringBrush}}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Сделок" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ResultTrades}" FontSize="18" FontWeight="Bold" 
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Win Rate" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource GreenBrush}">
                                        <Run Text="{Binding ResultWinRate, StringFormat=F1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Profit Factor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ResultProfitFactor, StringFormat=F2}" 
                                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Sharpe" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ResultSharpe, StringFormat=F2}" 
                                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Max DD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ResultMaxDD, StringFormat=F0}" 
                                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Equity Curve -->
                        <GroupBox Grid.Row="1" Header="Кривая доходности (Equity)" Margin="0,0,0,4">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                <Canvas Height="220" ClipToBounds="True">
                                    <Line X1="0" X2="680" 
                                          Y1="{Binding ZeroLineY}" Y2="{Binding ZeroLineY}"
                                          Stroke="{StaticResource TextSecondaryBrush}" 
                                          StrokeDashArray="4 2" StrokeThickness="1" Opacity="0.5"/>
                                    <Polyline Points="{Binding EquityPointsGeometry}" 
                                              Stroke="{StaticResource GreenBrush}" 
                                              StrokeThickness="2" 
                                              Fill="Transparent"/>
                                </Canvas>
                            </Border>
                        </GroupBox>

                        <!-- Таблица сделок -->
                        <GroupBox Grid.Row="2" Header="Сделки бэктеста">
                            <DataGrid ItemsSource="{Binding BacktestTrades}" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Вход" Binding="{Binding EntryTime, StringFormat=dd.MM.yy HH:mm}" Width="110"/>
                                    <DataGridTextColumn Header="Выход" Binding="{Binding ExitTime, StringFormat=dd.MM.yy HH:mm}" Width="110"/>
                                    <DataGridTextColumn Header="Напр." Binding="{Binding DirectionText}" Width="70"/>
                                    <DataGridTextColumn Header="Вход" Binding="{Binding EntryPrice, StringFormat=F2}" Width="80"/>
                                    <DataGridTextColumn Header="Выход" Binding="{Binding ExitPrice, StringFormat=F2}" Width="80"/>
                                    <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat=F2}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding PnL, Converter={StaticResource PnLColor}}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Кнопка применить -->
                        <Button Grid.Row="3" Content="📋 Применить параметры к торговле →" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyToTradingCommand}" 
                                HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Заявки и Котировки перенесены во вкладку Мониторинг -->
            <!-- ==================== ВКЛАДКА: СТРАТЕГИИ ==================== -->
            <TabItem Header="⚙️ Стратегии" DataContext="{Binding StrategyManagerVM}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Сводка -->
                        <RowDefinition Height="Auto"/>   <!-- Инструмент + STOP -->
                        <RowDefinition Height="*"/>      <!-- Список стратегий -->
                    </Grid.RowDefinitions>

                    <!-- Сводка -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Активных" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RunningCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Общий PnL" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalPnL, StringFormat={}{0:+#,0;-#,0;0}}" FontSize="22" FontWeight="Bold" 
                                           Foreground="{Binding TotalPnLColor, Converter={StaticResource StringBrush}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Сделок" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalTrades}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Управление -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Инструмент:" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" 
                                      Width="100" Margin="8,0,24,0" VerticalAlignment="Center"/>
                            <Button Content="🔴 СТОП ВСЕХ" Style="{StaticResource DangerButton}" 
                                    Command="{Binding EmergencyStopAllCommand}" 
                                    Padding="16,6" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Список стратегий -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Strategies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- Статус -->
                                            <ColumnDefinition Width="180"/>   <!-- Имя -->
                                            <ColumnDefinition Width="80"/>    <!-- Тикер -->
                                            <ColumnDefinition Width="100"/>   <!-- PnL -->
                                            <ColumnDefinition Width="80"/>    <!-- Сделки -->
                                            <ColumnDefinition Width="80"/>    <!-- Позиции -->
                                            <ColumnDefinition Width="100"/>   <!-- Время -->
                                            <ColumnDefinition Width="*"/>     <!-- Кнопки -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Статус -->
                                        <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,10,0"
                                                 Fill="{Binding StateColor, Converter={StaticResource StringBrush}}"/>

                                        <!-- Имя -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11" 
                                                       Foreground="{Binding StateColor, Converter={StaticResource StringBrush}}"/>
                                        </StackPanel>

                                        <!-- Тикер -->
                                        <TextBlock Grid.Column="2" Text="{Binding Ticker}" VerticalAlignment="Center" 
                                                   FontSize="13" Foreground="{StaticResource AccentBrush}"/>

                                        <!-- PnL -->
                                        <TextBlock Grid.Column="3" Text="{Binding PnL, StringFormat={}{0:+#,0;-#,0;0} ₽}" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{Binding PnLColor, Converter={StaticResource StringBrush}}"/>

                                        <!-- Сделки -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TradesCount}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="сделок" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Позиции -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OpenPositions}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource YellowBrush}"/>
                                            <TextBlock Text="позиций" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Время -->
                                        <TextBlock Grid.Column="6" Text="{Binding RunDuration}" VerticalAlignment="Center" 
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <!-- Кнопки -->
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="▶" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.StartStrategyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanStart}"/>
                                            <Button Content="⏸" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.PauseStrategyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanPause}"/>
                                            <Button Content="⏹" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.StopStrategyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanStop}"/>
                                            <Button Content="🔴 Стоп торги" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.StopAndCloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Остановить и закрыть все позиции"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- ==================== ВКЛАДКА: СТАКАН ==================== -->
            <TabItem Header="📊 Стакан" DataContext="{Binding OrderBookVM}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>  <!-- Стакан -->
                        <ColumnDefinition Width="*"/>    <!-- График -->
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ ПАНЕЛЬ: Стакан -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Выбор -->
                            <RowDefinition Height="Auto"/>   <!-- Позиция -->
                            <RowDefinition Height="*"/>      <!-- Лестница -->
                            <RowDefinition Height="Auto"/>   <!-- Спред -->
                        </Grid.RowDefinitions>

                        <!-- Выбор инструмента -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" Width="90"/>
                                <Button Content="🔄" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding SubscribeCommand}" Padding="6,2" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Позиция -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Напр." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PosDirection}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ср. цена" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PosAvgPrice, StringFormat=F2}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Объём" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PosVolume}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="PnL" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PosPnL, StringFormat={}{0:+0;-0;0}}" FontWeight="Bold" FontSize="13"
                                               Foreground="{Binding PosPnLColor, Converter={StaticResource StringBrush}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ценовая лестница -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OrderBookRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,1" Background="{Binding RowBackground, Converter={StaticResource StringBrush}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>  <!-- Bid -->
                                                        <ColumnDefinition Width="80"/>  <!-- Price -->
                                                        <ColumnDefinition Width="80"/>  <!-- Ask -->
                                                        <ColumnDefinition Width="*"/>   <!-- Our -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Bid bar + volume -->
                                                    <Grid Grid.Column="0">
                                                        <Border HorizontalAlignment="Right" 
                                                                Width="{Binding BidBarWidth}" 
                                                                Background="#3322C55E" CornerRadius="2"/>
                                                        <TextBlock Text="{Binding BidVolume}" HorizontalAlignment="Right" 
                                                                   Foreground="{StaticResource GreenBrush}" FontSize="12" FontFamily="Consolas" Margin="0,0,4,0"
                                                                   Visibility="{Binding BidVolume, Converter={StaticResource NonZeroVis}}"/>
                                                    </Grid>

                                                    <!-- Price -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat=F2}" 
                                                               HorizontalAlignment="Center" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"/>

                                                    <!-- Ask bar + volume -->
                                                    <Grid Grid.Column="2">
                                                        <Border HorizontalAlignment="Left" 
                                                                Width="{Binding AskBarWidth}" 
                                                                Background="#33EF4444" CornerRadius="2"/>
                                                        <TextBlock Text="{Binding AskVolume}" HorizontalAlignment="Left" 
                                                                   Foreground="{StaticResource RedBrush}" FontSize="12" FontFamily="Consolas" Margin="4,0,0,0"
                                                                   Visibility="{Binding AskVolume, Converter={StaticResource NonZeroVis}}"/>
                                                    </Grid>

                                                    <!-- Our orders/positions -->
                                                    <TextBlock Grid.Column="3" Text="{Binding OurInfo}" FontSize="10" 
                                                               Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Bid/Ask/Спред убраны — отображаются в карточках справа -->
                    </Grid>

                    <!-- ПРАВАЯ ПАНЕЛЬ: Котировки + График -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Котировки -->
                            <RowDefinition Height="Auto"/>  <!-- Таймфрейм -->
                            <RowDefinition Height="*"/>     <!-- График -->
                        </Grid.RowDefinitions>

                        <!-- Котировки -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Последняя" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastPrice, StringFormat=F2}" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Bid" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BestBid, StringFormat=F2}" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Ask" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BestAsk, StringFormat=F2}" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Спред" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpreadValue, StringFormat=F2}" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource YellowBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Таймфреймы -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TF:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding Timeframes}" SelectedItem="{Binding SelectedTimeframe}" Width="70"/>
                                <TextBlock Text="{Binding CandleCount, StringFormat='{}{0} свечей'}" 
                                           VerticalAlignment="Center" Margin="16,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Canvas для графика -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="4">
                            <Canvas x:Name="ChartCanvas" ClipToBounds="True" Background="#FF1A1A2E"
                                    MouseWheel="ChartCanvas_MouseWheel"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== ВКЛАДКА: НАСТРОЙКИ ==================== -->
            <TabItem Header="⚙️ Настройки" DataContext="{Binding SettingsVM}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0" Text="🔑 Токены брокеров" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Токен Финам -->
                    <GroupBox Grid.Row="1" Header="Финам Trade API" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Токен:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="FinamTokenBox" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Статус:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding FinamTokenMasked}" VerticalAlignment="Center" 
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Токен Альфа -->
                    <GroupBox Grid.Row="2" Header="Альфа-Инвестиции" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Токен:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="AlfaTokenBox" VerticalAlignment="Center" Margin="0,0,0,8"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Статус:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding AlfaTokenMasked}" VerticalAlignment="Center" 
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding SaveCommand}" Padding="20,8" FontSize="14"/>
                        <Button Content="📋 Из ENV" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding LoadFromEnvCommand}" Margin="12,0,0,0" Padding="16,8"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" 
                                   Margin="20,0,0,0" FontSize="13" Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>

                    <!-- Пояснение -->
                    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Как получить токены:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="22">
                                <Run FontWeight="SemiBold" Text="Финам:"/><Run Text=" Зайдите на "/><Run Text="api.finam.ru" FontWeight="SemiBold"/><Run Text=" → Токены → Создать новый токен. Скопируйте secret key."/>
                                <LineBreak/>
                                <Run FontWeight="SemiBold" Text="Альфа:"/><Run Text=" Личный кабинет Альфа-Инвестиций → Настройки → API-токены."/>
                                <LineBreak/><LineBreak/>
                                <Run Text="Токены сохраняются в settings.json рядом с приложением. При следующем запуске загружаются автоматически."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
