<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HedgeFund.Brokers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\HedgeFund.Core.csproj" />
  </ItemGroup>

  <!-- ============================================== -->
  <!-- gRPC / Protobuf (существующий FinamConnector)   -->
  <!-- ============================================== -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.*" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.15.*" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.*" />
    <PackageReference Include="Grpc.Tools" Version="2.67.*" PrivateAssets="All" />
  </ItemGroup>

  <!-- ============================================== -->
  <!-- StockSharp: аналитика + готовый Finam коннектор -->
  <!-- Версия 5.0.222 поддерживает net6.0 (совместим с net10.0) -->
  <!-- ============================================== -->
  <ItemGroup>
    <!-- Ядро: алгоритмы, стратегии, коннекторы -->
    <PackageReference Include="StockSharp.Algo" Version="5.0.222" />
    <!-- Сущности: Security, Order, Trade, Portfolio -->
    <PackageReference Include="StockSharp.BusinessEntities" Version="5.0.216" />
    <!-- Сообщения: базовый слой коммуникации -->
    <PackageReference Include="StockSharp.Messages" Version="5.0.222" />
    <!-- Готовый Finam коннектор (БЕСПЛАТНО) -->
    <PackageReference Include="StockSharp.Finam" Version="5.0.198" />
  </ItemGroup>

  <ItemGroup>
    <!-- Finam Trade API gRPC services -->
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\accounts\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\assets\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\auth\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\marketdata\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\orders\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\reports\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\metrics\*.proto" GrpcServices="Client" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\side.proto" GrpcServices="None" ProtoRoot="Finam\Protos" />
    <Protobuf Include="Finam\Protos\grpc\tradeapi\v1\trade.proto" GrpcServices="None" ProtoRoot="Finam\Protos" />
    <!-- gateway annotations (import dependency) -->
    <Protobuf Include="Finam\Protos\grpc\gateway\**\*.proto" GrpcServices="None" ProtoRoot="Finam\Protos" />
    <!-- google well-known types: import-only, no C# codegen (classes come from NuGet) -->
    <Protobuf Include="Finam\Protos\google\**\*.proto" GrpcServices="None" ProtoRoot="Finam\Protos" Access="Internal" CompileOutputs="false" />
  </ItemGroup>

</Project>
