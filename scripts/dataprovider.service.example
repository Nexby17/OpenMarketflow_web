[Unit]
Description=Finam DataProvider — FastAPI candle/quote cache
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/HedgeFund/DataProvider
EnvironmentFile=/path/to/HedgeFund/.env
ExecStart=/usr/bin/python3 /path/to/HedgeFund/DataProvider/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
