# === Finam Trade API ===
# Get your API key at https://trade-api.finam.ru/
FINAM_API_KEY=your_finam_api_key_here
FINAM_API_KEY_2=your_second_api_key_here
FINAM_ACCOUNT_ID=your_account_id
FINAM_ACCOUNT=your_second_account_id

# === Finam JWT Token ===
# Refreshed automatically by C# server / DataProvider on startup
FINAM_TOKEN=

# === Web UI Auth ===
APP_LOGIN=admin
APP_PASS_HASH=sha256_hash_of_your_password_base64_encoded

# === Robot defaults ===
ROBOT_TICKER=SiU6
ROBOT_SYMBOL=SiU6@RTSX
FINAM_ACCOUNT_KEY=main
